---
import Layout from "@/layouts/Layout.astro";
import WorkIndex from "@/components/WorkIndex.astro";
import labs from "@/data/labs.json";
---

<Layout
  title="Tools & Experiments"
  description="Independent browser tools, creative software, technical demos, and developer workbenches. Availability and product type are labeled separately."
>
  <div class="wrap page-head stack">
    <p class="kick">
      <span class="idx">TOOLS</span> - Independent software.
    </p>
    <h1 class="page-title">Tools & Experiments</h1>
    <p class="text-dim measure">
      Live entries are finished browser tools you can use today - things I created for my own use over the years and
      decided to keep online for anyone who finds them handy. Demos and workbenches are labeled by what they are and by
      their current development status.
    </p>
  </div>

  <section class="wrap region" aria-label="Tools and experiments index">
    <WorkIndex variant="registry" />
    <p class="catalog-note label">
      {labs.length} ENTRIES · STATUS DESCRIBES AVAILABILITY · TYPE DESCRIBES WHAT IT IS
    </p>
  </section>
</Layout>
