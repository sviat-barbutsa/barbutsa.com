---
import Layout from "@/layouts/Layout.astro";
import labs from "@/data/labs.json";

const statusLabel: Record<string, string> = {
  live: "LIVE",
  porting: "PORTING",
  wip: "WIP",
  archived: "ARCHIVED",
};
---

<Layout
  title="Lab"
  description="Independent experiments across AI, computer vision, WebGL, and frontend architecture. Each lab runs on its own subdomain, isolated from everything else."
>
  <div class="wrap page-head stack">
    <p class="kick"><span class="idx">LAB</span> Independent deployments, one per subdomain</p>
    <h1 style="max-width: 16ch;">Ambitious pieces, isolated enough to be reliable.</h1>
    <p class="text-dim measure">
      Each lab is its own deployment on its own subdomain. A heavy model or a
      broken experiment cannot touch this site or the other labs — the
      architecture is the thesis.
    </p>
  </div>

  <section class="wrap region" aria-label="Lab index">
    {
      labs.map((lab, i) => (
        <article class="index-row" id={lab.slug} data-state={lab.status === "live" ? "featured" : undefined}>
          <span class="no">/{String(i + 1).padStart(2, "0")}</span>
          <div>
            <h2 style="font-size: var(--step-1);">
              {lab.status === "live" ? (
                <a href={lab.url} rel="noopener noreferrer" target="_blank" data-no-prerender>
                  {lab.title} ↗
                </a>
              ) : (
                lab.title
              )}
            </h2>
            <p class="text-dim" style="font-size: var(--step--1); max-width: 52ch;">
              {lab.oneLiner}
            </p>
            <p class="label" style="margin-top: var(--space-2xs);">
              {lab.stack.join(" · ").toUpperCase()}
            </p>
          </div>
          <span class="label" data-tone={lab.status === "live" ? "signal" : undefined}>
            {statusLabel[lab.status] ?? lab.status.toUpperCase()}
          </span>
        </article>
      ))
    }
    <p class="label" style="margin-top: var(--space-m);">
      {labs.length} UNITS · PORTING = EXTRACTION FROM THE PREVIOUS SITE IN PROGRESS · ALL SHIP WITH SOURCE
    </p>
  </section>
</Layout>
