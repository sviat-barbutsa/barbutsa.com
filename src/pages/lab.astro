---
import Layout from "@/layouts/Layout.astro";
import labs from "@/data/labs.json";

/* A lab gets a card artwork by dropping a pre-optimized 208×208
   `public/labs/<slug>.webp` — the file's existence is the flag; labs.json
   stays schema-clean and the build needs no image pipeline. */
const labArt = import.meta.glob("../../public/labs/*.webp");
const hasArt = (slug: string): boolean => `../../public/labs/${slug}.webp` in labArt;

/* Live labs lead the index; stable sort preserves curated order otherwise. */
const orderedLabs = [...labs].sort((a, b) => Number(b.status === "live") - Number(a.status === "live"));

const statusLabel: Record<string, string> = {
  live: "LIVE",
  porting: "PORTING",
  wip: "WIP",
  archived: "ARCHIVED",
};
---

<Layout
  title="Lab"
  description="Independent experiments across AI, computer vision, WebGL, and frontend architecture. Each lab runs on its own subdomain, isolated from everything else."
>
  <div class="wrap page-head stack">
    <p class="kick">
      <span class="idx">LAB</span> Independent deployments, one per subdomain
    </p>
    <h1 class="page-title">Ambitious pieces, isolated enough to be reliable.</h1>
    <p class="text-dim measure">
      Each lab is its own deployment on its own subdomain. A heavy model or a broken experiment cannot touch this site
      or the other labs — the architecture is the thesis.
    </p>
  </div>

  <section class="wrap region" aria-label="Lab index">
    {
      orderedLabs.map((lab, i) => {
        const art = hasArt(lab.slug);
        return (
          <article
            class="index-row"
            id={lab.slug}
            data-state={lab.status === "live" ? "featured" : undefined}
            data-has-art={art ? "" : undefined}
          >
            <span class="no">/{String(i + 1).padStart(2, "0")}</span>
            <div>
              <h2 class="index-title">
                {lab.status === "live" ? (
                  <a href={lab.url} rel="noopener noreferrer" target="_blank" data-no-prerender>
                    {lab.title} ↗
                  </a>
                ) : (
                  lab.title
                )}
              </h2>
              <p class="index-summary text-dim">{lab.oneLiner}</p>
              <p class="index-meta label">{lab.stack.join(" · ").toUpperCase()}</p>
            </div>
            {art && (
              <img
                src={`/labs/${lab.slug}.webp`}
                alt=""
                width="480"
                height="480"
                loading="lazy"
                decoding="async"
                class="lab-art"
              />
            )}
            {lab.status === "live" ? (
              <span class="label status-pin">
                <i aria-hidden="true" />
                LIVE
              </span>
            ) : (
              <span class="label">{statusLabel[lab.status] ?? lab.status.toUpperCase()}</span>
            )}
          </article>
        );
      })
    }
    <p class="catalog-note label">
      {labs.length} UNITS · PORTING = EXTRACTION FROM THE PREVIOUS SITE IN PROGRESS · ALL SHIP WITH SOURCE
    </p>
  </section>
</Layout>
