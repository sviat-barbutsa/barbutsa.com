---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import { getPublishedArticles } from "@/lib/content/articles";

export const getStaticPaths = (async () => {
  const articles = await getPublishedArticles();
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}) satisfies GetStaticPaths;

const { article } = Astro.props;
const { Content } = await render(article);
const fmt = article.data.date.toLocaleDateString("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
});
---

<Layout
  title={article.data.title}
  description={article.data.summary}
  type="article"
  publishedTime={article.data.date}
  section={article.data.category}
  cover={article.data.cover}
  originalUrl={article.data.originalUrl}
>
  <article class="article-report wrap region stack" style="--flow: var(--space-l);">
    <header class="article-header stack" style="--flow: var(--space-m);">
      <p class="kick">
        <span class="idx">{article.data.category.toUpperCase()}</span>
        {fmt.toUpperCase()} · {article.data.readTime.toUpperCase()} READ
      </p>
      <h1 class="article-title">{article.data.title}</h1>
      <p class="article-summary text-dim">
        {article.data.summary}
      </p>
      {
        article.data.originalUrl && article.data.originalPlatform && (
          <p class="label article-origin">
            First published on{" "}
            <a href={article.data.originalUrl} target="_blank" rel="noopener noreferrer">
              {article.data.originalPlatform} ↗
            </a>
          </p>
        )
      }
    </header>

    <div class="prose">
      <Content />
    </div>

    <nav class="pager" aria-label="Article navigation">
      <a href="/articles">← ALL ARTICLES</a>
      <span class="label">END OF REPORT</span>
    </nav>
  </article>
</Layout>
