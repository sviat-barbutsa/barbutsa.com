---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="404" description="Route not found.">
  <div class="wrap region stack">
    <p class="kick"><span class="idx">404</span> Route not found</p>
    <h1 class="page-title">This path is outside the current map.</h1>
    <p class="text-dim measure">
      No edge node answers to this address. The atlas covers every route that exists — this is not one of them.
    </p>
    <p class="label">STATUS: 404 · CACHE: MISS · SUGGESTED ROUTE: /</p>
    <p>
      <a class="btn" href="/">← Back to origin</a>
    </p>
  </div>
</Layout>
