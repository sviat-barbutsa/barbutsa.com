---
import CaseStudyPage from "@/components/CaseStudyPage.astro";
import "@/styles/components/case-study.css";

const description =
  "Llamail is a self-hosted email agent with validated command and intent routing, local hybrid retrieval, cited answers, and human-reviewed actions through Telegram.";
---

<CaseStudyPage
  slug="llamail"
  title="Llamail"
  description={description}
  kickerLabel="SYSTEM"
  eyebrow="Independent local-first email agent · 2026"
  status="SELF-HOSTED · NO PUBLIC DEMO"
  lead="I created a self-hosted email agent that combines hybrid retrieval with a small local model to search my mailbox, answer questions with citations, draft replies, and route actions through Telegram."
  ownership="I designed and implemented the FastAPI services, routing, retrieval, local-model integration, storage, Telegram workflow, and operator interface."
  primaryAction={{
    label: "Read the implementation series →",
    href: "/articles/private-local-ai-email-agent",
    external: false,
  }}
  overviewTitle="How a request moves through Llamail."
  evidenceTitle="Telegram interface and system architecture."
  evidenceIntro="The sanitized Telegram capture shows cited answers and incoming-email analysis. The diagram maps Gmail and Telegram onto the local FastAPI, retrieval, storage, and model services."
  boundaryTitle="Where Llamail runs."
  facts={[
    { label: "Role", value: "Independent system · implemented end to end" },
    { label: "Runtime", value: "FastAPI · llama.cpp · local GPU" },
    { label: "Retrieval", value: "ChromaDB + SQLite FTS5" },
    { label: "Interface", value: "Telegram via n8n" },
  ]}
  overview={[
    "Slash commands and recognized compound commands go directly to application handlers. For free-form requests, the local model classifies the intent, then application code validates the result and calls the matching handler.",
    "Sable is the Telegram interface and operator persona for Llamail. It presents cited answers, reports incoming-email analysis, and shows drafts or mailbox actions for review before execution.",
  ]}
  highlights={[
    {
      title: "Command routing",
      description:
        "Known slash and compound commands go straight to handlers. Free-form messages return a structured intent from the local classifier to the same validated application handlers.",
    },
    {
      title: "Hybrid retrieval with citations",
      description:
        "The retriever combines semantic search in ChromaDB with keyword search in SQLite FTS5, and answers link back to the retrieved email evidence.",
    },
    {
      title: "Human-reviewed actions",
      description:
        "The interface shows the interpreted request and proposed draft or mailbox action for operator review before execution.",
    },
    {
      title: "Measured on local hardware",
      description:
        "On my RTX 4080 Mobile 12 GB system, hybrid search took about 3 seconds, retrieval plus answer generation about 7 seconds, and natural-language intent classification about 4 seconds.",
    },
  ]}
  relatedArticles={[
    {
      title: "From Inbox to Character: Creating a Private, Local AI Email Agent",
      summary: "The complete system, local-model runtime, Telegram interface, storage, and operating boundary.",
      href: "/articles/private-local-ai-email-agent",
    },
    {
      title: "How /search and /ask Work: Local Hybrid RAG with ChromaDB + SQLite FTS5",
      summary: "Weighted semantic and keyword retrieval across a large mailbox, with relevance-aware citations.",
      href: "/articles/local-hybrid-rag-chromadb-sqlite-fts5",
    },
    {
      title: "LLM as Router: Intent Classification for a Local Telegram Email Agent",
      summary: "Slash commands and deterministic handlers first; natural-language classification only as a fallback.",
      href: "/articles/llm-as-router-intent-classification",
    },
    {
      title: "Implementation Lessons: Hidden Headaches of a Local Gmail AI Agent",
      summary: "Gmail synchronization, labels, threads, identifiers, and the failure modes that shaped the design.",
      href: "/articles/hidden-headaches-local-gmail-ai-agent",
    },
    {
      title: "LLM-Personalized Email Campaigns with Python, Gmail, and Local AI",
      summary: "Previewed personalization, throttled delivery, reply tracking, and conservative classification.",
      href: "/articles/llm-personalized-email-campaigns",
    },
  ]}
  evidence={[
    {
      src: "/work/llamail-telegram.jpg",
      alt: "Sanitized Telegram capture of Sable returning a cited Llamail answer and an incoming-email analysis report",
      width: 1080,
      height: 2340,
      caption: "Sanitized Sable Telegram UI · cited answer and operator-visible email analysis",
      format: "mobile",
    },
    {
      src: "/work/llamail/llamail-architecture.png",
      alt: "Llamail architecture diagram separating Telegram and Gmail services from the local FastAPI, retrieval, storage, and model runtime",
      width: 840,
      height: 418,
      caption: "System boundary · external Gmail and Telegram routes around local inference, retrieval, and state",
    },
  ]}
  boundaries={[
    "Local inference, embeddings, FastAPI services, SQLite FTS5, and ChromaDB run on my machine. Gmail and Telegram provide the external mailbox and messaging connections through their APIs.",
    "Running Llamail requires user-owned Gmail and Telegram integrations plus local model hardware, so this project page uses sanitized screenshots in place of a public demo.",
  ]}
/>
