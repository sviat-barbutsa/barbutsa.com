---
import CaseStudyPage from "@/components/CaseStudyPage.astro";
import "@/styles/components/case-study.css";

const description =
  "English Voice Coach is a local-first Android speaking coach with voice, text, and photo practice, on-device correction, repeat matching, and review workflows.";
---

<CaseStudyPage
  slug="english-voice-coach"
  title="English Voice Coach"
  description={description}
  kickerLabel="PRODUCT"
  eyebrow="Independent Android product · 2026"
  status="GOOGLE PLAY CLOSED TEST · IN REVIEW"
  lead="I created a private Android speaking coach that accepts voice, typed sentences, and photographed text, then provides corrections, explanations, natural alternatives, playback, and repeat practice."
  ownership="I designed and implemented the Flutter app, Android/JNI integration, local inference, storage, model setup, test coverage, release preparation, and practice experience."
  primaryAction={{
    label: "Watch the four demo videos ↗",
    href: "https://www.youtube.com/playlist?list=PLSFpAE7CkhDg",
    external: true,
  }}
  overviewTitle="One practice loop across voice, text, and real-world English."
  evidenceTitle="Current Android release-candidate interface."
  evidenceIntro="The product began under the working name English Practice. The screenshots below show the current English Voice Coach release-candidate interface."
  boundaryTitle="Setup, privacy, and release status."
  galleryLayout="mobile-grid"
  facts={[
    { label: "Role", value: "Independent product · implemented end to end" },
    { label: "Platform", value: "Flutter · Android/JNI" },
    { label: "Local runtime", value: "whisper.cpp · LiteRT-LM" },
    { label: "Release", value: "Play closed test · in review" },
  ]}
  overview={[
    "Voice practice records a short phrase and transcribes it with native whisper.cpp. Text practice sends typed English directly to the correction boundary, while photo practice uses Android image selection and ML Kit OCR before entering the same correction flow. Gemma through LiteRT-LM returns a correction, a natural alternative, an explanation, and structured issue details.",
    "Flutter owns the product interface and state. Android platform channels own recording, local model files, native inference, OCR, and speech playback. Completed attempts are organized into topic-based review. Corrected or natural phrases can be played and repeated locally, and practice content stays on the device during normal use.",
  ]}
  highlights={[
    {
      title: "Three useful input paths",
      description:
        "Speak, type, or photograph English text. Every input goes through the same correction, practice-history, and review flow.",
    },
    {
      title: "On-device inference and fallbacks",
      description:
        "Whisper transcription and Gemma correction run through Android platform channels. When correction fails after a successful transcription, the transcript stays available. Android TextToSpeech handles playback when the optional neural voice is unavailable.",
    },
    {
      title: "Word-level repeat matching",
      description:
        "The percentage compares the target phrase with the locally transcribed repeat at word level. It shows how closely the words match; pronunciation, accent, and fluency are outside this measurement.",
    },
    {
      title: "Tested on a physical Android device",
      description:
        "I tested the implemented flows on a Samsung SM-S938U1. The release record includes 150 passing Flutter tests, analyzer checks, APK and App Bundle generation, signing, and Play upload.",
    },
  ]}
  evidence={[
    {
      src: "/work/english-voice-coach/01-topics-local-first.jpg",
      alt: "English Voice Coach home screen showing local speech, grammar, and voice readiness with practice topics",
      width: 1080,
      height: 2160,
      caption: "Current release identity · local runtime readiness and topic-based practice",
      format: "mobile",
    },
    {
      src: "/work/english-voice-coach/02-voice-practice.jpg",
      alt: "English Voice Coach voice practice screen with topic selection and a large tap-to-record microphone control",
      width: 1080,
      height: 2160,
      caption: "Voice practice · native recording and local transcription entry point",
      format: "mobile",
    },
    {
      src: "/work/english-voice-coach/03-correction-and-natural.jpg",
      alt: "English Voice Coach result showing original text, correction, natural version, playback, and explanation",
      width: 1080,
      height: 2160,
      caption: "Correction result · corrected and natural phrasing with listening and repeat actions",
      format: "mobile",
    },
    {
      src: "/work/english-voice-coach/04-repeat-match.jpg",
      alt: "English Voice Coach repeat-practice screen showing a 76 percent word-level phrase match and the transcribed repeat",
      width: 1080,
      height: 2160,
      caption: "Repeat practice · word-level target-to-transcript comparison",
      format: "mobile",
    },
    {
      src: "/work/english-voice-coach/05-review-by-topic.jpg",
      alt: "English Voice Coach review screen grouping saved practice attempts and common issues by topic",
      width: 1080,
      height: 2160,
      caption: "Review · saved attempts, issue categories, search, and practice-again workflow",
      format: "mobile",
    },
  ]}
  boundaries={[
    "After setup, transcription, correction, phrase matching, practice history, and supported voice playback run on the Android device. First-run setup downloads validated model files over HTTPS and needs substantial storage; a feedback report containing generated output leaves the device only after the user reviews it and taps Send.",
    "The current Android release is in Google Play closed-test review and is unavailable for public installation.",
  ]}
/>
