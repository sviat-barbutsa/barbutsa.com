---
import CaseStudyPage from "@/components/CaseStudyPage.astro";
import "@/styles/components/case-study.css";

const description =
  "A commissioned WordPress delivery by Sviatoslav Barbutsa: responsive appliance-repair booking, service guides, and ZIP-based Greater Houston coverage.";
---

<CaseStudyPage
  slug="north-peak-appliance-repair"
  title="North Peak Appliance Repair"
  description={description}
  eyebrow="Commissioned WordPress delivery · 2026"
  status="LIVE CLIENT WEBSITE"
  lead="I designed and implemented a responsive WordPress site for a Greater Houston appliance-repair business, covering booking, service guides, ZIP-based coverage, and client administration."
  ownership="I handled the web architecture, custom theme and plugin development, responsive UX, booking workflow, service-area tools, and delivery documentation."
  publicUrl="https://northpeakfastrepair.com/"
  publicActionLabel="Visit live website ↗"
  overviewTitle="How the booking site works."
  evidenceTitle="Homepage, service guides, coverage, and mobile booking."
  evidenceIntro="These captures show the live homepage, nine appliance service guides, ZIP coverage tools, and the mobile service-request entry point."
  boundaryTitle="Scope of this case study."
  facts={[
    { label: "Engagement", value: "Commissioned client delivery" },
    { label: "Role", value: "Web Architect & Full-Stack WordPress Developer" },
    { label: "Platform", value: "WordPress · PHP · JavaScript" },
    { label: "Public state", value: "Live client website" },
  ]}
  overview={[
    "Customers choose an appliance, enter the service address and issue details, select a preferred date and arrival window, and submit the appointment request in one flow.",
    "I separated the responsive theme from the business logic. The companion plugin manages services, booking records, scheduling rules, notifications, and business settings through WordPress administration.",
  ]}
  highlights={[
    {
      title: "Booking request flow",
      description:
        "The form collects the appliance, service address, preferred date, arrival window, and issue details in one request.",
    },
    {
      title: "Structured service content",
      description:
        "Nine appliance guides explain common problems and connect each service page with the matching booking options.",
    },
    {
      title: "ZIP-based service coverage",
      description:
        "A Leaflet map, ZIP checker, and client-managed zones show approximate coverage before the submitted request goes through scheduling confirmation.",
    },
    {
      title: "WordPress handover",
      description:
        "The client received administration access for content, booking statuses, and business settings, along with operating guides and handover documentation.",
    },
  ]}
  evidence={[
    {
      src: "/work/north-peak/north-peak-homepage-showcase.png",
      alt: "North Peak Appliance Repair homepage with a service offer and clear booking actions",
      width: 950,
      height: 712,
      caption: "Homepage service-request path · live client website",
    },
    {
      src: "/work/north-peak/north-peak-services.png",
      alt: "North Peak appliance service guide grid for refrigerator, washer, dryer, and other repairs",
      width: 1585,
      height: 906,
      caption: "Service discovery links visitors to nine focused repair guides.",
    },
    {
      src: "/work/north-peak/north-peak-service-area.png",
      alt: "North Peak Greater Houston service-area page with ZIP polygons, coverage checker, and communities",
      width: 1585,
      height: 906,
      caption: "The updated ZIP-based service-area map and coverage checker.",
    },
    {
      src: "/work/north-peak/north-peak-mobile.png",
      alt: "North Peak responsive mobile homepage with service offer and booking actions",
      width: 375,
      height: 680,
      caption: "Mobile service-request path.",
      format: "mobile",
    },
  ]}
  boundaries={[
    "This case study shows the delivered website and current public pages. Live business content belongs to the client; customer requests and WordPress administration remain private.",
  ]}
/>
