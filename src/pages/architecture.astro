---
import Layout from "@/layouts/Layout.astro";
import caseStudies from "@/data/case-studies.json";
---

<Layout
  title="Architecture"
  description="Architecture notes on real-time collaboration, Cloudflare-first SaaS, RAG pipelines, agentic workflows, and enterprise frontend foundations."
>
  <div class="wrap page-head stack">
    <p class="kick">
      <span class="idx">ARCH</span> Architecture notes - patterns & trade-offs
    </p>
    <h1 class="page-title">Architecture notes, drawn as routes.</h1>
    <p class="text-dim measure">
      Concise design explorations and generalized production patterns: where boundaries go, which trade-offs matter, and
      how each path is expected to fail.
    </p>
  </div>

  <section class="wrap region" aria-label="Architecture notes">
    <div class="grid" style="--grid-min: 22rem; --grid-gap: var(--space-m);">
      {
        caseStudies.map((cs, i) => (
          <article class="panel stack" style="--flow: var(--space-xs);" id={cs.slug}>
            <div class="repel">
              <span class="label" data-tone="signal">
                ROUTE {String(i + 1).padStart(2, "0")} ○ {cs.route.join(" - ")}
              </span>
            </div>
            <h2 class="panel-title">{cs.title}</h2>
            <p class="panel-summary text-dim">{cs.summary}</p>
            <p class="panel-meta label">{cs.stack.join(" · ").toUpperCase()}</p>
          </article>
        ))
      }
    </div>

    <div class="section-closing stack">
      <p class="text-dim">
        Five notes on system design. Each asks the same question:
        <strong>where do the boundaries go, and what happens when a piece fails?</strong> The interesting parts are load-bearing.
        Everything else is intentionally dull.
      </p>
      <p>
        <a class="btn" data-kind="ghost" href="/contact">Discuss an architecture review →</a>
      </p>
    </div>
  </section>
</Layout>
