---
import Layout from "@/layouts/Layout.astro";
import { careerTimeline, formatCareerMonth, toCareerDateTime } from "@/data/career-timeline";
import { site } from "@/data/site";

const config = [
  ["role", site.role],
  ["current", "lead software engineer · ai-powered collaborative saas"],
  ["experience", "13+ years implementing high-impact web platforms"],
  ["frontend", "shared ui · storybook · design systems"],
  ["architecture", "state stores · repositories · api adapters · dependency injection"],
  ["backend", "cloudflare workers · node.js · python · fastapi · django / drf · rest apis"],
  ["realtime", "websockets · durable objects · WebRTC"],
  ["ai", "rag · llm routing · agentic workflows · local LLM · Codex · Claude"],
  ["performance", "lighthouse 100 · 2.5–3× page-load optimization "],
  ["leadership", "frontend-led product teams up to 7 · mentored 14 engineers"],
  ["proof", site.facts.proof],
  ["location", "houston, tx · remote · u.s. work authorization"],
  ["doctrine", "boring where it matters, ambitious where it is isolated"],
];

const independent = [
  {
    title: "Local-first AI assistant",
    note: "Private, fully local agent (Telegram + email) with LLM-as-router intent classification and hybrid RAG on ChromaDB + SQLite FTS5. No cloud dependency.",
  },
  {
    title: "Offline Android AI English-practice app",
    note: "On-device models for pronunciation and grammar training; privacy-preserving mobile AI.",
  },
];

const education = [
  "M.S., Power Generation / Alternative Energy (GPA 3.96/4.0) and B.S., Electrical Engineering - Chernivtsi National University, Ukraine. Evaluated as equivalent to U.S. M.S. and B.S.",
  "Deep Learning Specialization (5 courses) - DeepLearning.AI, 2025. CS50 Web Programming - Harvard/edX. CIW JavaScript Specialist.",
];
---

<Layout
  title="About"
  description="Sviatoslav Barbutsa - 13+ years in frontend architecture, shared UI, Cloudflare and Node/Python integrations, real-time systems, applied AI, and technical leadership."
>
  <div class="wrap page-head stack">
    <p class="kick">
      <span class="idx">CONF</span> About - operator configuration
    </p>
    <h1 class="page-title" data-measure="compact">Senior engineering for products that need to keep evolving.</h1>
  </div>

  <section class="wrap region">
    <div class="sidebar" style="--sidebar-width: 24rem;">
      <div class="about-copy stack" style="--flow: var(--space-m);">
        <p>
          Thirteen years creating web platforms from scratch. Currently lead software engineer on an AI-powered
          collaborative SaaS, leading end-to-end frontend architecture across multiple React/Next.js applications in a
          monorepo. I created the shared UI library and Storybook foundation, with state stores, repositories, API
          adapters, dependency injection, and utility services separating the product layers.
        </p>
        <p class="text-dim">
          My work is frontend-first and extends through backend implementation and integration: Cloudflare Workers and
          Durable Objects, Node.js, Python, FastAPI, Django/DRF, and REST APIs. I have shipped real-time collaboration
          over WebSockets and applied-AI systems including RAG and vector search, LLM routing, agentic workflows, and
          local models.
        </p>
        <p class="text-dim">
          I have taken four products from empty repositories to production launch. Performance work includes Lighthouse
          100 sites and 2.5–3× page-load improvements on production apps. I led frontend architecture and delivery
          across product teams of up to seven, coordinating frontend engineers, backend contributors, and design. Across
          my career, I mentored 14 engineers and owned production quality for the systems I led. The doctrine has not
          changed in a decade: boring tools where they matter, ambitious pieces isolated enough to be reliable.
        </p>
      </div>

      <div class="panel">
        <p class="contact-panel-title label" data-tone="signal">$ cat /etc/operator.conf</p>
        <dl class="conf">
          {
            config.map(([key, value]) => (
              <div class="conf-row">
                <dt class="mono">{key}</dt>
                <dd>{value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <section class="wrap region stack" aria-labelledby="h-timeline">
    <p class="kick"><span class="idx">02</span> Service record</p>
    <h2 id="h-timeline" class="visually-hidden">Career timeline</h2>
    <p class="career-timeline-intro text-dim">
      Thirteen years of continuous progression from client web delivery to frontend architecture, full-stack systems,
      platform engineering, and applied AI.
    </p>
    <div class="career-timeline">
      {
        careerTimeline.map((entry) => (
          <article
            class="index-row"
            data-layout="timeline"
            data-career-id={entry.id}
            data-current={entry.current ? "true" : undefined}
          >
            <span class="no career-dates" aria-label={entry.displayDates}>
              <time datetime={toCareerDateTime(entry.start)}>{formatCareerMonth(entry.start)}</time>
              <span aria-hidden="true"> - </span>
              {entry.end ? (
                <time datetime={toCareerDateTime(entry.end)}>{formatCareerMonth(entry.end)}</time>
              ) : (
                <span>Present</span>
              )}
            </span>
            <div class="career-entry">
              <div class="index-title-row">
                <h3 class="index-title" data-size="body" data-weight="semibold">
                  {entry.publicTitle ?? entry.formalTitle}
                </h3>
                {entry.current && (
                  <span class="career-current label" data-tone="signal">
                    Current
                  </span>
                )}
              </div>
              <p class="career-organization">
                <strong class="career-employer">{entry.employer}</strong>
                {entry.client && (
                  <>
                    <span aria-hidden="true"> · </span>
                    <span class="career-client text-dim">client: {entry.client}</span>
                  </>
                )}
              </p>
              <p class="index-summary text-dim">{entry.summary}</p>
              {entry.projectSlug && (
                <p class="index-meta">
                  <a class="career-case-link" href={entry.projectSlug}>
                    View historical case study <span aria-hidden="true">→</span>
                  </a>
                </p>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="wrap region stack" aria-labelledby="h-indep">
    <p class="kick"><span class="idx">03</span> Independent AI projects</p>
    <h2 id="h-indep" class="visually-hidden">Independent projects</h2>
    <div class="grid" style="--grid-min: 20rem;">
      {
        independent.map((p) => (
          <div class="panel stack" style="--flow: var(--space-2xs);">
            <h3 class="panel-title" data-size="body">
              {p.title}
            </h3>
            <p class="panel-summary text-dim">{p.note}</p>
          </div>
        ))
      }
    </div>
    <div class="about-education stack" style="--flow: var(--space-2xs);">
      {education.map((line) => <p class="text-dim">{line}</p>)}
    </div>
    <p class="label">
      {site.facts.proof.toUpperCase()} · {site.facts.location.toUpperCase()}
    </p>
  </section>
</Layout>
