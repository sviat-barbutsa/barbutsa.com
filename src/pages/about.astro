---
import Layout from "@/layouts/Layout.astro";
import { careerTimeline, formatCareerMonth, toCareerDateTime } from "@/data/career-timeline";
import { site } from "@/data/site";

const config = [
  ["role", site.role],
  ["recent", "frontend architecture · ai-powered collaborative saas · 2020-2026"],
  ["experience", "13+ years implementing high-impact web platforms"],
  ["frontend", "shared ui · storybook · design systems"],
  ["architecture", "state stores · repositories · api adapters · dependency injection"],
  ["backend", "cloudflare workers · node.js · python · fastapi · django / drf · rest apis"],
  ["realtime", "websockets · durable objects · WebRTC"],
  ["ai", "rag · llm routing · agentic workflows · local LLM · Codex · Claude"],
  ["performance", "lighthouse 100 · 2.5–3× page-load optimization "],
  ["leadership", "frontend-led product teams up to 7 · mentored 14 engineers"],
  ["proof", site.facts.proof],
  ["location", "houston, tx · remote · u.s. work authorization"],
  ["doctrine", "boring where it matters, ambitious where isolated"],
];

const independent = [
  {
    title: "Local-first AI assistant",
    note: "Private agent with local model inference and data, LLM-as-router intent classification, and hybrid RAG on ChromaDB + SQLite FTS5. Integrates with Gmail and Telegram without a paid model API.",
  },
  {
    title: "Offline Android AI English-practice app",
    note: "On-device models for pronunciation and grammar training; privacy-preserving mobile AI.",
  },
];

const education =
  "M.S., Power Generation / Alternative Energy (GPA 3.96/4.0) and B.S., Electrical Engineering - Chernivtsi National University, Ukraine. Evaluated as equivalent to U.S. M.S. and B.S.";

const selectedCredentials = [
  {
    title: "Deep Learning Specialization",
    issuer: "DeepLearning.AI · Coursera",
    year: "2025",
    href: "https://coursera.org/verify/specialization/EFQV27OD8RPL",
    action: "Verify credential",
  },
  {
    title: "CS50's Web Programming with Python and JavaScript",
    issuer: "Harvard University · CS50",
    year: "2023",
    href: "https://cs50.harvard.edu/certificates/b2e41973-76aa-4c88-a46a-5d3699d6ec0b",
    action: "Verify credential",
  },
  {
    title: "CIW JavaScript Specialist",
    issuer: "CIW",
    year: "2016",
    href: "/certificates/ciw-javascript-specialist.png",
    action: "View certificate",
  },
];
---

<Layout
  title="About"
  description="Sviatoslav Barbutsa - 13+ years in frontend architecture, shared UI, Cloudflare and Node/Python integrations, real-time systems, applied AI, and technical leadership."
>
  <div class="wrap page-head stack">
    <p class="kick">
      <span class="idx">CONF</span> About - operator configuration
    </p>
    <h1 class="page-title" data-measure="compact">Senior engineering for products that need to keep evolving.</h1>
  </div>

  <section class="wrap region">
    <div class="sidebar" style="--sidebar-width: 24rem;">
      <div class="about-copy stack" style="--flow: var(--space-m);">
        <p>
          Over more than 13 years, I've worked on large enterprise platforms, early-stage products, and smaller client
          projects. I've created several web platforms from scratch, including products that remain commercially active
          today. I've also joined mature codebases to modernize legacy code, improve performance, and keep delivery
          moving.
        </p>
        <p>
          Most recently, I led frontend architecture for an AI-powered collaborative SaaS spanning multiple React and
          Next.js applications in a monorepo. I designed its architecture around SOLID principles, clear module
          boundaries, predictable state, and explicit dependencies. Although frontend architecture is my strongest area,
          I have also delivered Cloudflare Workers, Node.js services, and Python services, along with product-facing AI
          integrations involving RAG, LLM routing, and agentic workflows.
        </p>
        <p>
          I use AI coding tools to accelerate research, implementation, and verification. I review and test their
          output, understand the code before accepting it, and remain responsible for the architecture, quality,
          security, and production behavior.
        </p>
        <p>
          On the performance side, I've optimized production apps to hit Lighthouse 100s and cut page-load times by
          2.5–3×. I've also led frontend architecture and delivery across product teams of up to seven people,
          coordinating frontend engineers, backend contributors, and design, and mentored 14 engineers across my career.
          My engineering philosophy hasn't changed in a decade: use boring, proven tools where stability matters, and
          isolate the ambitious pieces so the whole system stays reliable.
        </p>
      </div>

      <div class="panel">
        <p class="contact-panel-title label" data-tone="signal">$ cat /etc/operator.conf</p>
        <dl class="conf">
          {
            config.map(([key, value]) => (
              <div class="conf-row">
                <dt class="mono">{key}</dt>
                <dd>{value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <section class="wrap region stack" aria-labelledby="h-timeline">
    <p class="kick"><span class="idx">02</span> Service record</p>
    <h2 id="h-timeline" class="visually-hidden">Career timeline</h2>
    <p class="career-timeline-intro text-dim">
      Thirteen years of continuous progression from client web delivery to frontend architecture, full-stack systems,
      platform engineering, and applied AI.
    </p>
    <div class="career-timeline">
      {
        careerTimeline.map((entry) => (
          <article
            class="index-row"
            data-layout="timeline"
            data-career-id={entry.id}
            data-current={entry.current ? "true" : undefined}
          >
            <span class="no career-dates" aria-label={entry.displayDates}>
              <time datetime={toCareerDateTime(entry.start)}>{formatCareerMonth(entry.start)}</time>
              <span aria-hidden="true"> - </span>
              {entry.end ? (
                <time datetime={toCareerDateTime(entry.end)}>{formatCareerMonth(entry.end)}</time>
              ) : (
                <span>Present</span>
              )}
            </span>
            <div class="career-entry">
              <div class="index-title-row">
                <h3 class="index-title" data-size="body" data-weight="semibold">
                  {entry.publicTitle ?? entry.formalTitle}
                </h3>
                {entry.current && (
                  <span class="career-current label" data-tone="signal">
                    Current
                  </span>
                )}
              </div>
              <p class="career-organization">
                <strong class="career-employer">{entry.employer}</strong>
                {entry.client && (
                  <>
                    <span aria-hidden="true"> · </span>
                    <span class="career-client text-dim">client: {entry.client}</span>
                  </>
                )}
              </p>
              <p class="index-summary text-dim">{entry.summary}</p>
              {entry.projectSlug && (
                <p class="index-meta">
                  <a class="career-case-link" href={entry.projectSlug}>
                    View historical case study <span aria-hidden="true">→</span>
                  </a>
                </p>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="wrap region stack about-education" aria-labelledby="h-credentials">
    <p class="kick"><span class="idx">03</span> Education & selected certifications</p>
    <h2 id="h-credentials" class="visually-hidden">Education and selected certifications</h2>
    <p class="education-summary text-dim">{education}</p>
    <div class="credential-list">
      {
        selectedCredentials.map((credential) => (
          <article class="credential-row">
            <div class="credential-copy">
              <h3 class="credential-title">{credential.title}</h3>
              <p class="credential-meta text-dim">
                {credential.issuer} · <time datetime={credential.year}>{credential.year}</time>
              </p>
            </div>
            <a
              class="credential-link"
              href={credential.href}
              target="_blank"
              rel="noopener noreferrer"
              data-no-prerender
              aria-label={`${credential.action}: ${credential.title}`}
            >
              {credential.action} <span aria-hidden="true">↗</span>
            </a>
          </article>
        ))
      }
    </div>
  </section>

  <section class="wrap region stack" aria-labelledby="h-indep">
    <p class="kick"><span class="idx">04</span> Independent AI projects</p>
    <h2 id="h-indep" class="visually-hidden">Independent projects</h2>
    <div class="grid" style="--grid-min: 20rem;">
      {
        independent.map((p) => (
          <div class="panel stack" style="--flow: var(--space-2xs);">
            <h3 class="panel-title" data-size="body">
              {p.title}
            </h3>
            <p class="panel-summary text-dim">{p.note}</p>
          </div>
        ))
      }
    </div>
    <p class="label">
      {site.facts.proof.toUpperCase()} · {site.facts.location.toUpperCase()}
    </p>
  </section>
</Layout>
