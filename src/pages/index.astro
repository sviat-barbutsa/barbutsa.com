---
import Layout from "@/layouts/Layout.astro";
import AtlasHero from "@/components/AtlasHero.astro";
import Doctrine from "@/components/Doctrine.astro";
import SelectedWork from "@/components/SelectedWork.astro";
import { site } from "@/data/site";
import caseStudies from "@/data/case-studies.json";
import { getRecentArticles } from "@/lib/content/articles";

const articles = await getRecentArticles(5);

const fmt = (d: Date) => d.toLocaleDateString("en-US", { month: "short", year: "numeric" }).toUpperCase();
---

<Layout>
  <!-- 00 · HERO -->
  <section class="wrap region hero-grid" data-shell-bounds>
    <div class="stack" style="--flow: var(--space-m);">
      <p class="kick">
        <span class="idx">{site.name.toUpperCase()}</span>
        {site.role.toUpperCase()}
      </p>
      <h1 class="hero-title">
        Systems that stay<br /><em>understandable.</em>
      </h1>
      <p class="measure text-dim">
        {site.positioning} React and TypeScript architecture, AI product systems, and SaaS that runs where the users are —
        on the edge.
      </p>
      <div class="cluster">
        <a class="btn" href="/lab">Selected work →</a>
        <a class="btn" data-kind="ghost" href="/architecture">How I think about systems</a>
      </div>
      <Doctrine />
    </div>
    <AtlasHero />
  </section>

  <SelectedWork />

  <!-- 02 · WRITING -->
  <section class="wrap region" aria-labelledby="h-writing">
    <div class="writing-grid">
      <div class="stack">
        <div class="repel">
          <p class="kick"><span class="idx">02</span> Writing</p>
          <a class="label" data-tone="signal" href="/articles">ALL ARTICLES →</a>
        </div>
        <h2 id="h-writing" class="section-title" data-measure="narrow">Notes from production.</h2>
        <p class="text-dim measure">
          Field reports, not think-pieces. Written after shipping, when the trade-offs were already paid for.
        </p>
      </div>
      <div>
        {
          articles.map((a) => (
            <a class="index-row" data-layout="home-writing" href={`/articles/${a.id}`}>
              <span class="no">{fmt(a.data.date)}</span>
              <h3 class="index-title" data-size="body">
                {a.data.title}
              </h3>
              <span class="label">{a.data.readTime.toUpperCase()}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 03 · ARCHITECTURE -->
  <section class="wrap region stack" aria-labelledby="h-arch">
    <p class="kick"><span class="idx">03</span> Architecture</p>
    <h2 id="h-arch" class="section-title">Case studies, drawn as routes.</h2>
    <p class="text-dim measure">
      Every system is a path a request takes. If you cannot draw the path in three nodes, the system is not done being
      designed.
    </p>
    <div class="grid" style="--grid-min: 20rem;">
      {
        caseStudies.slice(0, 4).map((cs) => (
          <a class="panel stack case-card" style="--flow: var(--space-xs);" href="/architecture">
            <span class="label" data-tone="signal">
              ROUTE ○ {cs.route.join(" — ")}
            </span>
            <h3 class="panel-title">{cs.title}</h3>
            <p class="panel-summary text-dim">{cs.summary}</p>
          </a>
        ))
      }
    </div>
  </section>

  <!-- 04 · CONTACT — left-aligned like every other region; the card on
       the right is contact.protocol (the operator.conf pattern) and is
       where the Sable assistant's entry line will live later. -->
  <section class="wrap region" aria-labelledby="h-contact">
    <div class="sidebar" style="--sidebar-width: 22rem;">
      <div class="stack" style="--flow: var(--space-m);">
        <p class="kick"><span class="idx">04</span> Contact</p>
        {
          /* clamp: "understandable?" (15 glyphs) must never break mid-word
            on narrow viewports — same guarantee as the hero title */
        }
        <h2 id="h-contact" class="home-contact-title">Have a system that needs to stay understandable?</h2>
        <p class="home-contact-copy text-dim">
          One message is enough. Describe the problem; I will tell you honestly whether I am the right person for it.
        </p>
        <p>
          <a class="contact-email mono" data-tone="signal" data-size="compact" href={`mailto:${site.email}`}>
            {site.email}
          </a>
        </p>
      </div>
      {
        /* the hero's frame grammar (atlas-frame: hairline + corner ticks +
          meta bar) applied to contact. The email lives on the left; the
          card ends with a $-prompt mailto so it stays self-contained. */
      }
      <aside class="proto-card atlas-frame" aria-label="Contact details">
        <p class="atlas-meta">
          <span>contact / protocol v1</span>
          <span class="status-pin"><i></i> OPEN</span>
        </p>
        <dl class="proto-rows">
          <div class="proto-row">
            <dt>base</dt>
            <dd>houston, tx · remote · u.s. work authorization</dd>
          </div>
          <div class="proto-row">
            <dt>response</dt>
            <dd>within 24 hours — honest either way</dd>
          </div>
          <div class="proto-row">
            <dt>elsewhere</dt>
            <dd>
              {
                site.social
                  .filter((s) => s.label !== "Email")
                  .map((s, i) => (
                    <>
                      {i > 0 && " · "}
                      <a href={s.href} data-no-prerender>
                        {s.label}
                      </a>
                    </>
                  ))
              }
            </dd>
          </div>
        </dl>
        <a class="proto-foot" href={`mailto:${site.email}`}>
          <span aria-hidden="true">$</span> say hello<span class="caret" aria-hidden="true"></span>
        </a>
      </aside>
    </div>
  </section>
</Layout>
