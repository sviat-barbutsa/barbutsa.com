---
import type { ImageMetadata } from "astro";
import "@/styles/main.css";
import "@/styles/fonts.css";
import { site } from "@/data/site";
import { PALETTE } from "@/theme/palette";
import { STORAGE_KEY } from "@/theme/state";
import StatusBar from "@/components/StatusBar.astro";
import SiteFooter from "@/components/layout/SiteFooter.astro";
import SiteHeader from "@/components/layout/SiteHeader.astro";
import XrayLegend from "@/components/layout/XrayLegend.astro";

/* Pre-paint inline blocks read PALETTE and STORAGE_KEY from the real
   modules, so these strings can't drift from tokens.css / theme/state.ts
   (palette-sync test covers the TS side). */
const themeBootstrap = `(() => {
  try {
    const t = localStorage.getItem("${STORAGE_KEY}");
    if (t === "light" || t === "dark") {
      document.documentElement.dataset.theme = t;
      const m = document.querySelector('meta[name="theme-color"]');
      if (m) m.content = t === "light" ? "${PALETTE.paper}" : "${PALETTE.ink}";
    }
  } catch {
    /* storage may be blocked before paint */
  }
})();`;

const canvasGuard = `
html { background-color: ${PALETTE.ink}; color-scheme: dark; }
html[data-theme="light"] { background-color: ${PALETTE.paper}; color-scheme: light; }
`;

interface Props {
  title?: string;
  documentTitle?: string;
  description?: string;
  type?: "website" | "article";
  publishedTime?: Date;
  section?: string;
  cover?: ImageMetadata | string;
  coverAlt?: string;
  /** where an article was first published; becomes BlogPosting.isBasedOn */
  originalUrl?: string;
  /** keep the page out of search results (it stays linkable and crawlable) */
  noindex?: boolean;
  structuredData?: Record<string, unknown> | readonly Record<string, unknown>[];
}

const {
  title,
  documentTitle,
  description = site.description,
  type = "website",
  publishedTime,
  section,
  cover,
  coverAlt,
  originalUrl,
  noindex = false,
  structuredData,
} = Astro.props;
const pageTitle = documentTitle ?? (title ? `${title} - ${site.name}` : `${site.name} - ${site.role}`);
const outputPath = Astro.url.pathname.replace(/\.html$/, "");
const path = outputPath === "/index" ? "/" : outputPath;
const canonicalUrl = new URL(path === "/" ? "/" : path, site.url);
const defaultOgImage = new URL("/og-image.png", site.url);
const coverSrc = typeof cover === "string" ? cover : cover?.src;
const ogImage = coverSrc ? new URL(coverSrc, site.url) : defaultOgImage;
const ogImageAlt = coverAlt ?? (cover && title ? title : `${site.name} - ${site.role} - barbutsa.com`);
const structuredNodes = structuredData ? (Array.isArray(structuredData) ? structuredData : [structuredData]) : [];
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${site.url}/#person`,
      name: site.name,
      jobTitle: site.role,
      email: `mailto:${site.email}`,
      url: site.url,
      image: defaultOgImage.href,
      sameAs: site.social.filter((s) => s.href.startsWith("https://")).map((s) => s.href),
    },
    {
      "@type": "WebSite",
      "@id": `${site.url}/#website`,
      name: site.name,
      description: site.description,
      url: site.url,
      publisher: { "@id": `${site.url}/#person` },
    },
    ...(type === "article" && publishedTime
      ? [
          {
            "@type": "BlogPosting",
            headline: title,
            description,
            datePublished: publishedTime.toISOString(),
            url: canonicalUrl.href,
            image: ogImage.href,
            author: { "@id": `${site.url}/#person` },
            mainEntityOfPage: canonicalUrl.href,
            ...(originalUrl ? { isBasedOn: originalUrl } : {}),
          },
        ]
      : []),
    ...structuredNodes,
  ],
};
/* JSON placed inside a <script> data block: JSON.stringify does not escape "<",
   so authored text containing "</script" would end the block early. Escape it
   (and the two Unicode line separators that are not valid in JS source). */
const jsonForScript = (value: unknown): string =>
  JSON.stringify(value)
    .replace(/</g, "\\u003c")
    .replace(/\u2028/g, "\\u2028")
    .replace(/\u2029/g, "\\u2029");
const speculationRules = {
  prerender: [
    {
      where: {
        and: [{ href_matches: "/*" }, { not: { selector_matches: "[data-no-prerender]" } }],
      },
      eagerness: "moderate",
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
    <meta name="theme-color" content={PALETTE.ink} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    {
      type === "article" && publishedTime && (
        <meta property="article:published_time" content={publishedTime.toISOString()} />
      )
    }
    {type === "article" && section && <meta property="article:section" content={section} />}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <script type="application/ld+json" is:inline set:html={jsonForScript(jsonLd)} />

    <!-- theme bootstrap - runs before the stylesheet paints. Applies only
         a STORED choice (no stored choice → tokens.css defaults to dark,
         OS preference is ignored). Also syncs the theme-color meta so the
         browser chrome matches right away. is:inline so Astro can't hoist it. -->
    <script is:inline set:html={themeBootstrap} />

    <!-- pre-CSS canvas guard - between documents the browser paints its
         default (white) canvas until the external stylesheet applies;
         with a render-blocking cross-origin font CSS that gap can
         outlive Chrome's paint holding and blink. This inline block
         mirrors the tokens.css theming model (dark default, OS ignored,
         explicit choice wins) so the canvas color is right immediately.
         tokens.css loads later in the cascade and overrides with the
         real values. -->
    <Fragment set:html={`<style>${canvasGuard}</style>`} />
    <!-- self-hosted fonts (scripts/fetch-fonts.mjs) -->
    <link
      rel="preload"
      href="/fonts/v9-3y9K6as8bTXqnANBjzKo3IeZx8z6up5BeSl9D4djx9PpZBMlGIInE.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/v24-tDbv2o-flEEny0FZhsfKu5WU4zr3EBX0PnT8RD8yKwBNntkaToggR7BYRbKPxDcwg.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- speculation rules: prerender internal links on interaction intent.
         Unsupported browsers just ignore the script tag. -->
    <script type="speculationrules" is:inline set:html={jsonForScript(speculationRules)} />

    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <SiteHeader path={path} />

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <SiteFooter />
    <XrayLegend />

    <StatusBar />

    <script>
      import { initThemeController } from "@/theme/theme-controller";
      import { initXray } from "@/lib/xray";
      import { initNavLine } from "@/lib/nav-line";
      const cleanups = [initThemeController(), initXray(), initNavLine()];
      /* persisted pagehide = the page goes into the back/forward cache and
         may come back, so don't tear down here - otherwise it gets restored
         with dead controllers. Cleanup only on a real unload. */
      addEventListener("pagehide", (event) => {
        if (event.persisted) return;
        cleanups.forEach((cleanup) => cleanup());
      });
    </script>
  </body>
</html>
