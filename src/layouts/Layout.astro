---
import type { ImageMetadata } from "astro";
import "@/styles/main.css";
import "@/styles/fonts.css";
import { site } from "@/data/site";
import { PALETTE } from "@/theme/palette";
import StatusBar from "@/components/StatusBar.astro";
import SiteFooter from "@/components/layout/SiteFooter.astro";
import SiteHeader from "@/components/layout/SiteHeader.astro";
import XrayLegend from "@/components/layout/XrayLegend.astro";

/* Pre-paint inline blocks are built from the canonical palette so these
   mirrors can never drift from tokens.css (palette-sync test guards the
   TS side; these strings guard themselves by construction). */
const themeBootstrap = `(() => {
  try {
    const t = localStorage.getItem("atlas-theme");
    if (t === "light" || t === "dark") {
      document.documentElement.dataset.theme = t;
      const m = document.querySelector('meta[name="theme-color"]');
      if (m) m.content = t === "light" ? "${PALETTE.paper}" : "${PALETTE.ink}";
    }
  } catch {
    /* storage may be blocked before paint */
  }
})();`;

const canvasGuard = `
html { background-color: ${PALETTE.ink}; color-scheme: dark; }
html[data-theme="light"] { background-color: ${PALETTE.paper}; color-scheme: light; }
`;

interface Props {
  title?: string;
  description?: string;
  type?: "website" | "article";
  publishedTime?: Date;
  section?: string;
  cover?: ImageMetadata;
}

const { title, description = site.description, type = "website", publishedTime, section, cover } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.role}`;
const path = Astro.url.pathname.replace(/\.html$/, "");
const canonicalUrl = new URL(path === "/" ? "/" : path, site.url);
const defaultOgImage = new URL("/og-image.png", site.url);
const ogImage = cover ? new URL(cover.src, site.url) : defaultOgImage;
const ogImageAlt = cover && title ? title : `${site.name} — ${site.role} — barbutsa.com`;
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${site.url}/#person`,
      name: site.name,
      jobTitle: site.role,
      email: `mailto:${site.email}`,
      url: site.url,
      image: defaultOgImage.href,
      sameAs: site.social.filter((s) => s.href.startsWith("https://")).map((s) => s.href),
    },
    {
      "@type": "WebSite",
      "@id": `${site.url}/#website`,
      name: site.name,
      description: site.description,
      url: site.url,
      publisher: { "@id": `${site.url}/#person` },
    },
    ...(type === "article" && publishedTime
      ? [
          {
            "@type": "BlogPosting",
            headline: title,
            description,
            datePublished: publishedTime.toISOString(),
            url: canonicalUrl.href,
            image: ogImage.href,
            author: { "@id": `${site.url}/#person` },
            mainEntityOfPage: canonicalUrl.href,
          },
        ]
      : []),
  ],
};
const speculationRules = {
  prerender: [
    {
      where: {
        and: [{ href_matches: "/*" }, { not: { selector_matches: "[data-no-prerender]" } }],
      },
      eagerness: "moderate",
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content={PALETTE.ink} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    {
      type === "article" && publishedTime && (
        <meta property="article:published_time" content={publishedTime.toISOString()} />
      )
    }
    {type === "article" && section && <meta property="article:section" content={section} />}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

    <!-- THEME BOOTSTRAP — before the stylesheet paints; applies only a
         STORED choice (absent one, tokens.css defaults to dark — the OS
         preference is deliberately ignored). Also syncs the theme-color
         meta so browser chrome matches from byte one.
         is:inline so Astro cannot hoist it. (Theme plan §6 / addendum A1) -->
    <script is:inline set:html={themeBootstrap} />

    <!-- PRE-CSS CANVAS GUARD — between documents the UA paints its
         default (white) canvas until the external stylesheet applies;
         with a render-blocking cross-origin font CSS that gap can
         outlive Chrome's paint holding and blink. This inline block
         mirrors tokens.css' theming model (dark-canonical, OS ignored,
         explicit choice wins) so the canvas is correct from byte one.
         tokens.css still owns the real values: it loads later in the
         cascade and overrides. -->
    <Fragment set:html={`<style>${canvasGuard}</style>`} />
    <!-- self-hosted fonts (scripts/fetch-fonts.mjs) -->
    <link
      rel="preload"
      href="/fonts/v9-3y9K6as8bTXqnANBjzKo3IeZx8z6up5BeSl9D4djx9PpZBMlGIInE.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/v24-tDbv2o-flEEny0FZhsfKu5WU4zr3EBX0PnT8RD8yKwBNntkaToggR7BYRbKPxDcwg.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Speculation Rules: prerender internal links on interaction intent.
         Unsupported browsers ignore the script tag entirely. (STACK_PLAN §6.1) -->
    <script type="speculationrules" is:inline set:html={JSON.stringify(speculationRules)} />

    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <SiteHeader path={path} />

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <SiteFooter />
    <XrayLegend />

    <StatusBar />

    <script>
      import { initThemeController } from "@/theme/theme-controller";
      import { initXray } from "@/lib/xray";
      import { initNavLine } from "@/lib/nav-line";
      const cleanups = [initThemeController(), initXray(), initNavLine()];
      addEventListener(
        "pagehide",
        () => {
          cleanups.forEach((cleanup) => cleanup());
        },
        { once: true },
      );
    </script>
  </body>
</html>
