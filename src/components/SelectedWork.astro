---
import labs from "@/data/labs.json";

/* Live labs lead the list — the registry's strongest claim goes first.
   Stable sort keeps the curated order within each group. Art mirrors the
   lab page: a `public/labs/<slug>.webp` is the flag. */
const orderedLabs = [...labs].sort((a, b) => Number(b.status === "live") - Number(a.status === "live"));
const labArt = import.meta.glob("../../public/labs/*.webp");
const hasArt = (slug: string): boolean => `../../public/labs/${slug}.webp` in labArt;
---

<!-- 01 · SELECTED WORK -->
<section class="wrap region stack" aria-labelledby="h-work">
  <div class="repel">
    <p class="kick"><span class="idx">01</span> Selected work — the lab</p>
    <a class="label" data-tone="signal" href="/lab">FULL INDEX →</a>
  </div>
  <h2 id="h-work" class="visually-hidden">Selected work</h2>
  <div class="work-split">
    <div>
      {
        orderedLabs.slice(0, 5).map((lab, i) => {
          const live = lab.status === "live";
          const art = live && hasArt(lab.slug);
          return (
            <a
              class="index-row"
              data-layout="home-work"
              href={live ? lab.url : `/lab#${lab.slug}`}
              data-state={live ? "featured" : undefined}
              {...(art
                ? {
                    "data-art": `/labs/${lab.slug}.webp`,
                    "data-art-name": lab.title,
                    "data-art-no": `/${String(i + 1).padStart(2, "0")}`,
                  }
                : {})}
              {...(live ? { target: "_blank", rel: "noopener noreferrer", "data-no-prerender": true } : {})}
            >
              <span class="no">/{String(i + 1).padStart(2, "0")}</span>
              <div>
                <div class="index-title-row">
                  <h3 class="index-title">
                    {lab.title}
                    {live && " ↗"}
                  </h3>
                  {live && (
                    <span class="label status-pin">
                      <i aria-hidden="true" />
                      LIVE
                    </span>
                  )}
                </div>
                <p class="index-summary text-dim">{lab.oneLiner}</p>
                <p class="index-meta label">{lab.stack.slice(0, 3).join(" · ").toUpperCase()}</p>
              </div>
              {art && (
                <span class="label viewing" aria-hidden="true">
                  VIEWING →
                </span>
              )}
            </a>
          );
        })
      }
    </div>
    {
      orderedLabs.slice(0, 5).some((lab) => lab.status === "live" && hasArt(lab.slug)) && (
        <figure class="work-preview" data-work-preview aria-hidden="true">
          <img data-layer alt="" width="480" height="480" loading="lazy" decoding="async" />
          <img data-layer alt="" width="480" height="480" loading="lazy" decoding="async" />
          <figcaption class="label">
            <span>
              <b data-preview-no /> · <span data-preview-name />
            </span>
            <span class="status-pin">
              <i aria-hidden="true" />
              LIVE
            </span>
          </figcaption>
        </figure>
      )
    }
  </div>
</section>

<script>
  /* One authoritative state: previewedProjectId. The highlighted row IS
     the project in the panel — highlight and crossfade commit together.
     Pointer commits after a short intent delay; keyboard is immediate;
     leaving the list keeps the last previewed project. */
  const previewRows = Array.from(document.querySelectorAll<HTMLElement>('[data-layout="home-work"][data-art]'));
  const previewPanel = document.querySelector<HTMLElement>("[data-work-preview]");
  if (previewPanel && previewRows.length > 0) {
    const layers = Array.from(previewPanel.querySelectorAll<HTMLImageElement>("[data-layer]"));
    const previewName = previewPanel.querySelector<HTMLElement>("[data-preview-name]");
    const previewNo = previewPanel.querySelector<HTMLElement>("[data-preview-no]");
    let front = 0;
    let current = "";
    let pending = 0;
    for (const row of previewRows) new Image().src = row.dataset.art ?? "";
    const commit = (row: HTMLElement): void => {
      const src = row.dataset.art ?? "";
      if (!src || src === current) return;
      current = src;
      const back = 1 - front;
      layers[back].src = src;
      layers[back].dataset.front = "true";
      delete layers[front].dataset.front;
      front = back;
      for (const other of previewRows) delete other.dataset.previewed;
      row.dataset.previewed = "";
      if (previewName) previewName.textContent = row.dataset.artName ?? "";
      if (previewNo) previewNo.textContent = row.dataset.artNo ?? "";
    };
    commit(previewRows[0]);
    for (const row of previewRows) {
      row.addEventListener("mouseenter", () => {
        window.clearTimeout(pending);
        pending = window.setTimeout(() => commit(row), 70);
      });
      row.addEventListener("mouseleave", () => window.clearTimeout(pending));
      row.addEventListener("focus", () => {
        window.clearTimeout(pending);
        commit(row);
      });
    }
  }
</script>
