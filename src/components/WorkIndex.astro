---
import labs from "@/data/labs.json";

/* One lab index, two surfaces. The home teaser and the /lab registry render
   the same rows, preview panel, and previewed-state behavior from this one
   component; the variant only sets scope — row count, anchor ids, heading
   depth, and how much registry detail (full stack, non-live status) shows. */
interface Props {
  variant: "home" | "registry";
}

const { variant } = Astro.props;
const registry = variant === "registry";
const Heading = registry ? "h2" : "h3";

/* Live labs lead the list — the registry's strongest claim goes first.
   Stable sort keeps the curated order within each group. Art flag: a
   pre-optimized `public/labs/<slug>.webp` exists — labs.json stays
   schema-clean and the build needs no image pipeline. */
const orderedLabs = [...labs].sort((a, b) => Number(b.status === "live") - Number(a.status === "live"));
const rows = registry ? orderedLabs : orderedLabs.slice(0, 5);
const labArt = import.meta.glob("../../public/labs/*.webp");
const hasArt = (slug: string): boolean => `../../public/labs/${slug}.webp` in labArt;

const statusLabel: Record<string, string> = {
  live: "LIVE",
  porting: "PORTING",
  wip: "WIP",
  archived: "ARCHIVED",
};
---

<div class="work-split">
  <div>
    {
      rows.map((lab, i) => {
        const live = lab.status === "live";
        const art = live && hasArt(lab.slug);
        const no = `/${String(i + 1).padStart(2, "0")}`;
        /* Live rows open the lab; home rows without a live URL anchor into
           the registry; registry rows without a live URL are plain entries. */
        const href = live ? lab.url : registry ? undefined : `/lab#${lab.slug}`;
        const Row = href ? "a" : "article";
        return (
          <Row
            class="index-row"
            data-layout="work"
            id={registry ? lab.slug : undefined}
            href={href}
            data-state={live ? "featured" : undefined}
            {...(art
              ? {
                  "data-art": `/labs/${lab.slug}.webp`,
                  "data-art-name": lab.title,
                  "data-art-no": no,
                }
              : {})}
            {...(live ? { target: "_blank", rel: "noopener noreferrer", "data-no-prerender": true } : {})}
          >
            <span class="no">{no}</span>
            <div>
              <div class="index-title-row">
                <Heading class="index-title">
                  {lab.title}
                  {live && " ↗"}
                </Heading>
                {live && (
                  <span class="label status-pin">
                    <i aria-hidden="true" />
                    LIVE
                  </span>
                )}
                {!live && registry && <span class="label">{statusLabel[lab.status] ?? lab.status.toUpperCase()}</span>}
              </div>
              <p class="index-summary text-dim">{lab.oneLiner}</p>
              <p class="index-meta label">{(registry ? lab.stack : lab.stack.slice(0, 3)).join(" · ").toUpperCase()}</p>
            </div>
            {art && (
              <span class="label viewing" aria-hidden="true">
                VIEWING →
              </span>
            )}
          </Row>
        );
      })
    }
  </div>
  {
    rows.some((lab) => lab.status === "live" && hasArt(lab.slug)) && (
      <figure class="work-preview" data-work-preview aria-hidden="true">
        <img data-layer alt="" width="480" height="480" loading="lazy" decoding="async" />
        <img data-layer alt="" width="480" height="480" loading="lazy" decoding="async" />
        <figcaption class="label">
          <span>
            <b data-preview-no /> · <span data-preview-name />
          </span>
          <span class="status-pin">
            <i aria-hidden="true" />
            LIVE
          </span>
        </figcaption>
      </figure>
    )
  }
</div>

<script>
  /* One authoritative state: previewedProjectId. The highlighted row IS
     the project in the panel — highlight and crossfade commit together.
     Pointer commits after a short intent delay; keyboard is immediate;
     leaving the list keeps the last previewed project. The panel is
     desktop-only (work-index.css hides it below 56.25em), so below the
     breakpoint nothing initializes: no art preload, no previewed state
     highlighting a row whose panel is not on screen. */
  const panelVisible = window.matchMedia("(min-width: 56.25em)");
  const initPreview = (): void => {
    const previewRows = Array.from(document.querySelectorAll<HTMLElement>('[data-layout="work"][data-art]'));
    const previewPanel = document.querySelector<HTMLElement>("[data-work-preview]");
    if (!previewPanel || previewRows.length === 0) return;
    const layers = Array.from(previewPanel.querySelectorAll<HTMLImageElement>("[data-layer]"));
    const previewName = previewPanel.querySelector<HTMLElement>("[data-preview-name]");
    const previewNo = previewPanel.querySelector<HTMLElement>("[data-preview-no]");
    let front = 0;
    let current = "";
    let pending = 0;
    for (const row of previewRows) new Image().src = row.dataset.art ?? "";
    const commit = (row: HTMLElement): void => {
      const src = row.dataset.art ?? "";
      if (!src || src === current) return;
      current = src;
      const back = 1 - front;
      layers[back].src = src;
      layers[back].dataset.front = "true";
      delete layers[front].dataset.front;
      front = back;
      for (const other of previewRows) delete other.dataset.previewed;
      row.dataset.previewed = "";
      if (previewName) previewName.textContent = row.dataset.artName ?? "";
      if (previewNo) previewNo.textContent = row.dataset.artNo ?? "";
    };
    commit(previewRows[0]);
    for (const row of previewRows) {
      row.addEventListener("mouseenter", () => {
        window.clearTimeout(pending);
        pending = window.setTimeout(() => commit(row), 70);
      });
      row.addEventListener("mouseleave", () => window.clearTimeout(pending));
      row.addEventListener("focus", () => {
        window.clearTimeout(pending);
        commit(row);
      });
    }
  };
  if (panelVisible.matches) {
    initPreview();
  } else {
    /* A first crossing (rotation, window resize) can only be to `matches`. */
    panelVisible.addEventListener("change", initPreview, { once: true });
  }
</script>
