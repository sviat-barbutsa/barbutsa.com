---
/**
 * The doctrine line — the hero <Typewriter> upgraded to a working
 * shell: click or focus+Enter, then `help`. Commands either act
 * (navigate, toggle theme/xray) or answer by typing into the same
 * line. Stays one line in every state thanks to the ghost-cell sizing.
 */
import Typewriter from "@/components/Typewriter.astro";
import doctrine from "@/data/doctrine.json";
---

<div data-doctrine>
  <Typewriter phrases={doctrine} srLabel="Field notes" />
</div>

<script>
  import { ambientControls } from "@/lib/typer";
  import { initShell, type ShellAction } from "@/lib/shell/controller";
  import { toggleXray } from "@/lib/xray";
  import { prefersReducedMotion } from "@/lib/runtime/reduced-motion";
  import { site } from "@/data/site";
  import labs from "@/data/labs.json";

  const root = document.querySelector<HTMLElement>("[data-doctrine] .typeline");
  if (root) {
    const ambient = ambientControls.get(root);
    const status = document.getElementById("theme-status");
    const liveLabs = labs.filter((lab) => lab.status === "live");
    const routeCommands = ["home", "work", "writing", "tools", "architecture", "about", "contact", "packages"];
    const liveToolCommands = liveLabs.map((lab) => lab.slug);

    const nav = (href: string): ShellAction => ({ type: "go", href });

    const commands: Record<string, ShellAction> = {
      help: {
        type: "say",
        text: "try: ls · ls tools · work · writing · tools · architecture · about · contact · theme · xray",
      },
      whoami: {
        type: "say",
        text: `${site.name} — ${site.role.toLowerCase()}`,
      },
      ls: {
        type: "say",
        text: routeCommands.join("  ") + "  · 1 hidden",
      },
      "ls labs": {
        type: "say",
        text: liveToolCommands.join("  ") || "no live tools",
      },
      "ls tools": {
        type: "say",
        text: liveToolCommands.join("  ") || "no live tools",
      },
      "ls -a": {
        type: "say",
        text: [...routeCommands, ...liveToolCommands, ".flamenco"].join("  "),
      },
      home: nav("/"),
      work: nav("/work"),
      tools: nav("/lab"),
      lab: nav("/lab"),
      labs: nav("/lab"),
      packages: nav("/packages"),
      writing: nav("/articles"),
      articles: nav("/articles"),
      architecture: nav("/architecture"),
      about: nav("/about"),
      cv: nav("/about"),
      contact: nav("/contact"),
      styleguide: nav("/styleguide"),
      email: nav(`mailto:${site.email}`),
      theme: {
        type: "run",
        fn: () => {
          document.querySelector<HTMLButtonElement>("[data-theme-toggle]")?.click();
        },
      },
      xray: {
        type: "run",
        fn: () => (toggleXray() ? "x-ray: on — the page is annotating itself" : "x-ray: off"),
      },
      clear: { type: "run", fn: () => {} },
    };

    for (const lab of liveLabs) {
      commands[lab.slug] = nav(lab.url);
    }

    /* easter egg - not listed in help, found via `ls -a`. Dynamic import
       so the game chunk only loads when actually opened. */
    const launchFlamenco = (): string | void => {
      if (prefersReducedMotion()) {
        return "this easter egg requires motion — respecting your settings";
      }
      void import("@/lib/flamenco").then((module) => module.openFlamenco(root));
    };
    commands["flamenco"] = { type: "run", fn: launchFlamenco };
    commands[".flamenco"] = { type: "run", fn: launchFlamenco };
    commands["./.flamenco"] = { type: "run", fn: launchFlamenco };

    const shell = initShell(root, {
      commands,
      suspendAmbient: () => ambient?.stop(),
      resumeAmbient: () => ambient?.start(),
      announce: (text) => {
        if (status) status.textContent = text;
      },
    });
    /* skip teardown when the page goes into bfcache - it may come back */
    addEventListener("pagehide", (event) => {
      if (event.persisted) return;
      shell.destroy();
    });
  }
</script>
