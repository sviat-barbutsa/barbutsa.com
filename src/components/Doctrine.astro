---
/**
 * The doctrine line — the hero's use of the generic <Typewriter>,
 * upgraded to a working shell (INSTRUMENTS_PLAN §3): click or
 * focus+Enter, then `help`. Commands act (navigate, toggle theme/xray)
 * or answer by typing into the same line. Always one line — the
 * ghost-cell sizing guarantee holds through every state.
 */
import Typewriter from "@/components/Typewriter.astro";
import doctrine from "@/data/doctrine.json";
---

<div data-doctrine>
  <Typewriter phrases={doctrine} srLabel="Field notes" />
</div>

<script>
  import { ambientControls } from "@/lib/typer";
  import { initShell, type ShellAction } from "@/lib/shell/controller";
  import { toggleXray } from "@/lib/xray";
  import { site } from "@/data/site";
  import labs from "@/data/labs.json";

  const root = document.querySelector<HTMLElement>("[data-doctrine] .typeline");
  if (root) {
    const ambient = ambientControls.get(root);
    const status = document.getElementById("theme-status");

    const nav = (href: string): ShellAction => ({ type: "go", href });

    const commands: Record<string, ShellAction> = {
      help: {
        type: "say",
        text: "commands: whoami · ls · articles · lab · packages · architecture · about · cv · contact · theme · xray · clear",
      },
      whoami: {
        type: "say",
        text: `${site.name} — ${site.role.toLowerCase()}`,
      },
      /* the truthful hint: real ls also admits what it isn't showing.
         A dev who reads "1 hidden" knows exactly what to type next. */
      ls: {
        type: "say",
        text: labs.map((l) => l.slug).join("  ") + "  · 1 hidden",
      },
      "ls labs": {
        type: "say",
        text: labs.map((l) => l.slug).join("  ") + "  · 1 hidden",
      },
      "ls -a": {
        type: "say",
        text: [".flamenco", ...labs.map((l) => l.slug)].join("  "),
      },
      home: nav("/"),
      lab: nav("/lab"),
      labs: nav("/lab"),
      packages: nav("/packages"),
      articles: nav("/articles"),
      architecture: nav("/architecture"),
      about: nav("/about"),
      cv: nav("/about"),
      contact: nav("/contact"),
      styleguide: nav("/styleguide"),
      email: nav(`mailto:${site.email}`),
      theme: {
        type: "run",
        fn: () => {
          document.querySelector<HTMLButtonElement>("[data-theme-toggle]")?.click();
        },
      },
      xray: {
        type: "run",
        fn: () => (toggleXray() ? "x-ray: on — the page is annotating itself" : "x-ray: off"),
      },
      clear: { type: "run", fn: () => {} },
    };

    /* the easter egg — NOT in help; found via `ls -a`. The game chunk
       loads only when summoned (dynamic import = zero cost otherwise). */
    const launchFlamenco = (): string | void => {
      if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
        return "this easter egg requires motion — respecting your settings";
      }
      const invoker = document.querySelector<HTMLElement>(".shell-open-btn");
      void import("@/lib/flamenco").then((module) => module.openFlamenco(invoker));
    };
    commands["flamenco"] = { type: "run", fn: launchFlamenco };
    commands[".flamenco"] = { type: "run", fn: launchFlamenco };
    commands["./.flamenco"] = { type: "run", fn: launchFlamenco };

    const shell = initShell(root, {
      commands,
      suspendAmbient: () => ambient?.stop(),
      resumeAmbient: () => ambient?.start(),
      announce: (text) => {
        if (status) status.textContent = text;
      },
    });
    addEventListener("pagehide", () => shell.destroy(), { once: true });
  }
</script>
