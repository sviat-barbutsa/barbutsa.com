---
/**
 * The one load-bearing animation on the site: a request finding its
 * nearest edge. SVG geometry from the approved Edge Atlas concept;
 * behavior in src/lib/atlas/svg-atlas.ts (route draw + pulse, hover
 * tooltips, hot nodes, live readout). Colors are 100% CSS tokens, so
 * both themes and the animated theme switch work untouched. Pauses
 * offscreen; renders a static routed state under reduced motion.
 */
---

<div class="atlas-shell">
  <figure class="atlas-frame" data-atlas-frame aria-label="Live edge network atlas">
    <figcaption class="atlas-meta">
      <span>edge-atlas / v2.4</span>
      <span class="live"><i aria-hidden="true"></i>observing</span>
    </figcaption>

    <svg
      data-atlas-svg
      viewBox="0 0 800 520"
      role="img"
      aria-label="Abstract map of edge network points of presence. A request pulse travels from the origin to the nearest edge node."
    >
      <!-- faint peer mesh -->
      <g class="mesh" aria-hidden="true">
        <path d="M300 130 Q345 105 390 110"></path>
        <path d="M390 110 Q465 115 540 150"></path>
        <path d="M330 80 Q315 105 300 130"></path>
        <path d="M330 80 Q360 88 390 110"></path>
        <path d="M130 200 Q210 145 300 130"></path>
        <path d="M130 200 Q145 320 200 420"></path>
        <path d="M690 170 Q680 255 640 340"></path>
        <path d="M640 340 Q685 385 720 440"></path>
        <path d="M560 260 Q600 295 640 340"></path>
        <path d="M390 110 Q480 170 560 260"></path>
        <path d="M540 150 Q555 205 560 260"></path>
        <path d="M200 420 Q325 440 450 430"></path>
        <path d="M450 430 Q505 340 560 260"></path>
        <path d="M450 430 Q585 445 720 440"></path>
        <path d="M540 150 Q615 150 690 170"></path>
      </g>

      <!-- spokes: origin to each PoP (ids consumed by svg-atlas.ts) -->
      <g aria-hidden="true">
        <path class="spoke" id="sp-WAW" d="M400 270 Q485 205 540 150"></path>
        <path class="spoke" id="sp-LHR" d="M400 270 Q335 195 300 130"></path>
        <path class="spoke" id="sp-FRA" d="M400 270 Q382 188 390 110"></path>
        <path class="spoke" id="sp-AMS" d="M400 270 Q352 172 330 80"></path>
        <path class="spoke" id="sp-IAD" d="M400 270 Q258 218 130 200"></path>
        <path class="spoke" id="sp-GRU" d="M400 270 Q288 358 200 420"></path>
        <path class="spoke" id="sp-NRT" d="M400 270 Q560 202 690 170"></path>
        <path class="spoke" id="sp-SIN" d="M400 270 Q525 318 640 340"></path>
        <path class="spoke" id="sp-SYD" d="M400 270 Q575 372 720 440"></path>
        <path class="spoke" id="sp-JNB" d="M400 270 Q432 352 450 430"></path>
        <path class="spoke" id="sp-DXB" d="M400 270 Q482 252 560 260"></path>
      </g>

      <!-- animated route + pulse -->
      <path class="route" data-route d="M400 270 Q485 205 540 150" aria-hidden="true"></path>
      <circle class="pulse" data-pulse r="3.5" cx="400" cy="270" aria-hidden="true"></circle>

      <!-- nodes -->
      <g class="node origin" tabindex="0" data-code="ORIGIN" data-city="Origin" data-role="Workers · D1 · R2">
        <circle class="halo" cx="400" cy="270" r="11"></circle>
        <circle class="core" cx="400" cy="270" r="4.5"></circle>
        <text x="400" y="296" text-anchor="middle">origin</text>
      </g>
      <g class="node" tabindex="0" data-code="WAW" data-city="Warsaw" data-role="edge PoP">
        <circle class="halo" cx="540" cy="150" r="9"></circle><circle class="core" cx="540" cy="150" r="3"></circle>
        <text x="554" y="146">WAW</text>
      </g>
      <g class="node" tabindex="0" data-code="LHR" data-city="London" data-role="edge PoP">
        <circle class="halo" cx="300" cy="130" r="9"></circle><circle class="core" cx="300" cy="130" r="3"></circle>
        <text x="266" y="126">LHR</text>
      </g>
      <g class="node" tabindex="0" data-code="FRA" data-city="Frankfurt" data-role="edge PoP">
        <circle class="halo" cx="390" cy="110" r="9"></circle><circle class="core" cx="390" cy="110" r="3"></circle>
        <text x="402" y="102">FRA</text>
      </g>
      <g class="node" tabindex="0" data-code="AMS" data-city="Amsterdam" data-role="edge PoP">
        <circle class="halo" cx="330" cy="80" r="9"></circle><circle class="core" cx="330" cy="80" r="3"></circle>
        <text x="330" y="62" text-anchor="middle">AMS</text>
      </g>
      <g class="node" tabindex="0" data-code="IAD" data-city="Washington DC" data-role="edge PoP">
        <circle class="halo" cx="130" cy="200" r="9"></circle><circle class="core" cx="130" cy="200" r="3"></circle>
        <text x="96" y="196">IAD</text>
      </g>
      <g class="node" tabindex="0" data-code="GRU" data-city="São Paulo" data-role="edge PoP">
        <circle class="halo" cx="200" cy="420" r="9"></circle><circle class="core" cx="200" cy="420" r="3"></circle>
        <text x="200" y="446" text-anchor="middle">GRU</text>
      </g>
      <g class="node" tabindex="0" data-code="NRT" data-city="Tokyo" data-role="edge PoP">
        <circle class="halo" cx="690" cy="170" r="9"></circle><circle class="core" cx="690" cy="170" r="3"></circle>
        <text x="704" y="166">NRT</text>
      </g>
      <g class="node" tabindex="0" data-code="SIN" data-city="Singapore" data-role="edge PoP">
        <circle class="halo" cx="640" cy="340" r="9"></circle><circle class="core" cx="640" cy="340" r="3"></circle>
        <text x="654" y="336">SIN</text>
      </g>
      <g class="node" tabindex="0" data-code="SYD" data-city="Sydney" data-role="edge PoP">
        <circle class="halo" cx="720" cy="440" r="9"></circle><circle class="core" cx="720" cy="440" r="3"></circle>
        <text x="720" y="466" text-anchor="middle">SYD</text>
      </g>
      <g class="node" tabindex="0" data-code="JNB" data-city="Johannesburg" data-role="edge PoP">
        <circle class="halo" cx="450" cy="430" r="9"></circle><circle class="core" cx="450" cy="430" r="3"></circle>
        <text x="450" y="456" text-anchor="middle">JNB</text>
      </g>
      <g class="node" tabindex="0" data-code="DXB" data-city="Dubai" data-role="edge PoP">
        <circle class="halo" cx="560" cy="260" r="9"></circle><circle class="core" cx="560" cy="260" r="3"></circle>
        <text x="574" y="256">DXB</text>
      </g>
    </svg>

    <div class="atlas-tip" data-atlas-tip role="status" aria-hidden="true"></div>

    <p class="readout" aria-live="polite">
      <span class="dot" aria-hidden="true"></span>
      <span data-readout-text>route: <b>WAW</b> → client · ttfb <b>28ms</b> · cache: <span class="hit">HIT</span></span>
      <span class="caret" aria-hidden="true"></span>
    </p>
  </figure>
</div>

<script>
  import { initAtlas } from "@/lib/atlas/svg-atlas";

  const frame = document.querySelector<HTMLElement>("[data-atlas-frame]");
  if (frame) initAtlas(frame);
</script>
