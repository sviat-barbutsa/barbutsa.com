---
import type { CollectionEntry } from "astro:content";

interface Props {
  articles: CollectionEntry<"articles">[];
}

const { articles } = Astro.props;
const fmt = (d: Date) =>
  d
    .toLocaleDateString("en-US", {
      month: "short",
      day: "2-digit",
      year: "numeric",
    })
    .toUpperCase();
---

<div>
  {
    articles.map((a) => (
      <a class="index-row" data-layout="dated" href={`/articles/${a.id}`}>
        <span class="no">{fmt(a.data.date)}</span>
        <div>
          <h2 class="index-title">{a.data.title}</h2>
          <p class="index-summary text-dim">{a.data.summary}</p>
        </div>
        <span class="label">
          {a.data.category.toUpperCase()} · {a.data.readTime.toUpperCase()}
        </span>
      </a>
    ))
  }
</div>
