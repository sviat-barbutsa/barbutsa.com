---
/**
 * Status bar — editor-style statusline at the bottom edge: current
 * section, scroll %, visitor colo + measured ttfb, theme, UTC clock.
 * Desktop only; aria-hidden because everything here is available
 * elsewhere on the page.
 */
---

<div class="status-bar" aria-hidden="true">
  <span class="sb-left">
    <span data-sb-section>—</span>
    <span class="sb-sep">·</span>
    <span data-sb-scroll>0%</span>
  </span>
  <span class="sb-right">
    <span data-sb-colo hidden></span>
    <span data-sb-theme>dark</span>
    <span class="sb-sep">·</span>
    <span data-sb-clock>utc --:--</span>
  </span>
</div>

<script>
  import { initStatusBar } from "@/lib/status-bar/controller";

  const bar = document.querySelector<HTMLElement>(".status-bar");
  if (bar) {
    const statusBar = initStatusBar(bar);
    /* skip teardown when the page goes into bfcache - it may come back */
    addEventListener("pagehide", (event) => {
      if (event.persisted) return;
      statusBar.destroy();
    });
  }
</script>
