---
/**
 * Status bar — editor-style statusline at the bottom edge
 * (INSTRUMENTS_PLAN §4). Ambient truth: current section, scroll %,
 * visitor colo + measured ttfb, theme, UTC clock. Desktop only;
 * aria-hidden (it duplicates information available elsewhere).
 */
---

<div class="status-bar" aria-hidden="true">
  <span class="sb-left">
    <span data-sb-section>—</span>
    <span class="sb-sep">·</span>
    <span data-sb-scroll>0%</span>
  </span>
  <span class="sb-right">
    <span data-sb-colo hidden></span>
    <span data-sb-theme>dark</span>
    <span class="sb-sep">·</span>
    <span data-sb-clock>utc --:--</span>
  </span>
</div>

<script>
  import { initStatusBar } from "@/lib/status-bar/controller";

  const bar = document.querySelector<HTMLElement>(".status-bar");
  if (bar) {
    const statusBar = initStatusBar(bar);
    addEventListener("pagehide", () => statusBar.destroy(), { once: true });
  }
</script>
